# Default deny-all rule; explicit allows below expose only public routes and proxied clientlibs
/0001 { /type "deny" /url "*" }

# Never expose /apps directly on Publish
/0010 { /type "deny" /url "/apps/*" }

# Allow proxied clientlibs served via allowProxy="{Boolean}true"
/0020 { /type "allow" /url "/etc.clientlibs/planfinder/*" }

# Allow public site pages and model JSON
/0030 { /type "allow" /url "/content/planfinder/*" }
/0031 { /type "allow" /url "/content/dam/planfinder/*" }
