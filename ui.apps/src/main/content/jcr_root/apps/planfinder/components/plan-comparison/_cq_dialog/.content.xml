<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Plan Comparison"
          sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <general
                        jcr:primaryType="nt:unstructured"
                        jcr:title="General"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <heading
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Heading"
                                                name="./heading"
                                                required="{Boolean}true"/>
                                            <subheading
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                fieldLabel="Subheading"
                                                name="./subheading"/>
                                            <disclaimer
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Disclaimer"
                                                name="./disclaimer"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </general>
                    <pricing
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Pricing Options"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <defaultCycle
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Default Billing Cycle"
                                                name="./defaultCycle">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <monthly
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Monthly"
                                                        value="monthly"/>
                                                    <annual
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Annual"
                                                        value="annual"/>
                                                </items>
                                            </defaultCycle>
                                            <annualDiscountPercent
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                fieldLabel="Annual Discount (%)"
                                                max="{Double}50"
                                                min="{Double}0"
                                                name="./annualDiscountPercent"
                                                step="1"
                                                value="15"/>
                                            <currencyCode
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Currency Code"
                                                name="./currencyCode"
                                                value="IDR"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </pricing>
                    <plans
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Plans"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <plansList
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Protection Plans">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./plans">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <id
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Plan ID"
                                                            name="./id"
                                                            required="{Boolean}true"/>
                                                        <title
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Plan Title"
                                                            name="./title"
                                                            required="{Boolean}true"/>
                                                        <category
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                            fieldLabel="Category"
                                                            name="./category">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <health
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Health"
                                                                    value="health"/>
                                                                <life
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Life"
                                                                    value="life"/>
                                                                <critical
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Critical Illness"
                                                                    value="critical"/>
                                                            </items>
                                                        </category>
                                                        <badge
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Highlight Badge"
                                                            name="./badge"/>
                                                        <monthlyRate
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                            fieldLabel="Base Monthly Rate"
                                                            min="{Double}0"
                                                            name="./monthlyRate"
                                                            required="{Boolean}true"
                                                            step="10000"/>
                                                        <roomLimit
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Room / Benefit Limit"
                                                            name="./roomLimit"/>
                                                        <annualLimit
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Annual Coverage Limit"
                                                            name="./annualLimit"/>
                                                        <featured
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                            name="./featured"
                                                            text="Feature this plan"
                                                            uncheckedValue="false"
                                                            value="true"/>
                                                        <features
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                            fieldLabel="Key Features">
                                                            <field
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                name="./features"/>
                                                        </features>
                                                        <ctaLabel
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="CTA Label"
                                                            name="./ctaLabel"
                                                            value="Select Plan"/>
                                                        <ctaLink
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                            fieldLabel="CTA Link"
                                                            name="./ctaLink"
                                                            rootPath="/content"/>
                                                    </items>
                                                </field>
                                            </plansList>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </plans>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
